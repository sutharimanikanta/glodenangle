# Gold Buy Advisor — Environment Variables
# Copy this file to .env and fill in your values

# Groq API Key (free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Gold Price API (free at https://www.goldapi.io — or leave default for demo mode)
GOLD_API_KEY=your_goldapi_io_key_here

# Backend URL (change if deploying)
BACKEND_URL=http://localhost:8000

# Database path
DATABASE_URL=sqlite+aiosqlite:///./gold_advisor.db

# App settings
APP_ENV=development
APP_SECRET_KEY=change_this_to_a_random_secret_string
